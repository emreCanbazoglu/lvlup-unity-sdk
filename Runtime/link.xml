<!--
    Preserves Unity IAP Product / ProductDefinition / ProductMetadata members
    that UnityIAPIntegration accesses via reflection. Without this, IL2CPP
    managed code stripping at High level can prune members that are never
    statically referenced, causing reflection bind to fail at runtime.

    Covers both Unity IAP 4.x (assembly `UnityEngine.Purchasing`) and 5.x
    (assembly renamed to `Unity.Purchasing`). The `ignoreIfMissing` attribute
    keeps this harmless when the Purchasing package isn't installed.
-->
<linker>
  <assembly fullname="UnityEngine.Purchasing" ignoreIfMissing="1">
    <type fullname="UnityEngine.Purchasing.Product" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductDefinition" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductMetadata" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductType" preserve="all"/>
  </assembly>
  <assembly fullname="Unity.Purchasing" ignoreIfMissing="1">
    <type fullname="UnityEngine.Purchasing.Product" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductDefinition" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductMetadata" preserve="all"/>
    <type fullname="UnityEngine.Purchasing.ProductType" preserve="all"/>
  </assembly>
</linker>
